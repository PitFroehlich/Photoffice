{
  "realm": "photoffice",
  "enabled": true,
  "displayName": "Photoffice",
  "internationalizationEnabled": true,
  "supportedLocales": ["de"],
  "defaultLocale": "de",
  "loginTheme": "photoffice",
  "emailTheme": "photoffice",
  "organizationsEnabled": true,
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "sslRequired": "external",
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "noreply@photoffice.test",
    "fromDisplayName": "Photoffice"
  },
  "roles": {
    "realm": [
      {
        "name": "platform-admin",
        "description": "Plattform-Betreiber: verwaltet Studios"
      },
      {
        "name": "studio-admin",
        "description": "Inhaber/Administrator eines Studios"
      },
      {
        "name": "photographer",
        "description": "Fotograf/Mitarbeiter eines Studios"
      },
      {
        "name": "default-roles-photoffice",
        "description": "Standardrollen – ohne Rollen der Keycloak-Kontoverwaltung (Client account), siehe ADR 0011"
      }
    ],
    "client": {
      "account": [
        {
          "name": "view-profile",
          "description": "${role_view-profile}"
        },
        {
          "name": "manage-account",
          "description": "${role_manage-account}",
          "composite": true,
          "composites": {
            "client": {
              "account": ["manage-account-links"]
            }
          }
        },
        {
          "name": "manage-account-links",
          "description": "${role_manage-account-links}"
        },
        {
          "name": "view-applications",
          "description": "${role_view-applications}"
        },
        {
          "name": "view-consent",
          "description": "${role_view-consent}"
        },
        {
          "name": "manage-consent",
          "description": "${role_manage-consent}",
          "composite": true,
          "composites": {
            "client": {
              "account": ["view-consent"]
            }
          }
        },
        {
          "name": "delete-account",
          "description": "${role_delete-account}"
        },
        {
          "name": "view-groups",
          "description": "${role_view-groups}"
        }
      ]
    }
  },
  "defaultRole": {
    "name": "default-roles-photoffice"
  },
  "clients": [
    {
      "clientId": "photoffice-api",
      "name": "Photoffice API (Audience)",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false
    },
    {
      "clientId": "photoffice-frontend",
      "name": "Photoffice Frontend",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:4200/*"
      ],
      "webOrigins": [
        "http://localhost:4200"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "basic",
        "email",
        "organization"
      ],
      "protocolMappers": [
        {
          "name": "audience photoffice-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "photoffice-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ],
      "fullScopeAllowed": false
    },
    {
      "clientId": "photoffice-dev-cli",
      "name": "Nur Entwicklung/Tests: Token per Passwort (Direct Access Grant)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "basic",
        "email",
        "organization"
      ],
      "protocolMappers": [
        {
          "name": "audience photoffice-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "photoffice-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ],
      "fullScopeAllowed": false
    },
    {
      "clientId": "photoffice-backend",
      "name": "Photoffice Backend (Service-Account für Studio-Onboarding)",
      "description": "Legt Organisationen und Studio-Admins an (Issue #24). Secret nur für Entwicklung.",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "photoffice-backend-dev-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false
    },
    {
      "clientId": "account",
      "name": "${client_account}",
      "description": "Keycloak-Kontoverwaltung (REST-API) – abgeschaltet: Profil und Passwort ändert man über das Benutzermenü der App (ADR 0011)",
      "enabled": false,
      "publicClient": true,
      "standardFlowEnabled": false,
      "rootUrl": "${authBaseUrl}",
      "baseUrl": "/realms/photoffice/account/",
      "redirectUris": [
        "/realms/photoffice/account/*"
      ],
      "fullScopeAllowed": false
    },
    {
      "clientId": "account-console",
      "name": "${client_account-console}",
      "description": "Keycloak-Kontoverwaltung (Oberfläche) – abgeschaltet, siehe Client account (ADR 0011)",
      "enabled": false,
      "publicClient": true,
      "standardFlowEnabled": false,
      "rootUrl": "${authBaseUrl}",
      "baseUrl": "/realms/photoffice/account/",
      "redirectUris": [
        "/realms/photoffice/account/*"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "fullScopeAllowed": false
    }
  ],
  "scopeMappings": [
    {
      "client": "photoffice-frontend",
      "roles": [
        "platform-admin",
        "studio-admin",
        "photographer"
      ]
    },
    {
      "client": "photoffice-dev-cli",
      "roles": [
        "platform-admin",
        "studio-admin",
        "photographer"
      ]
    }
  ],
  "clientScopeMappings": {
    "realm-management": [
      {
        "client": "photoffice-backend",
        "roles": [
          "manage-users",
          "view-users",
          "query-users",
          "manage-realm"
        ]
      }
    ]
  },
  "users": [
    {
      "username": "operator",
      "email": "operator@photoffice.test",
      "emailVerified": true,
      "firstName": "Paula",
      "lastName": "Plattform",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "operator",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-photoffice",
        "platform-admin"
      ]
    },
    {
      "username": "admin-a",
      "email": "admin@studio-a.test",
      "emailVerified": true,
      "firstName": "Anna",
      "lastName": "Admin",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "admin-a",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-photoffice",
        "studio-admin"
      ]
    },
    {
      "username": "foto-a",
      "email": "foto@studio-a.test",
      "emailVerified": true,
      "firstName": "Felix",
      "lastName": "Foto",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "foto-a",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-photoffice",
        "photographer"
      ]
    },
    {
      "username": "admin-b",
      "email": "admin@studio-b.test",
      "emailVerified": true,
      "firstName": "Bernd",
      "lastName": "Admin",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "admin-b",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-photoffice",
        "studio-admin"
      ]
    },
    {
      "username": "service-account-photoffice-backend",
      "enabled": true,
      "serviceAccountClientId": "photoffice-backend",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users",
          "manage-realm"
        ]
      }
    }
  ],
  "organizations": [
    {
      "name": "Studio A",
      "alias": "studio-a",
      "enabled": true,
      "domains": [
        {
          "name": "studio-a.test",
          "verified": false
        }
      ],
      "members": [
        {
          "username": "admin-a",
          "membershipType": "MANAGED"
        },
        {
          "username": "foto-a",
          "membershipType": "MANAGED"
        }
      ]
    },
    {
      "name": "Studio B",
      "alias": "studio-b",
      "enabled": true,
      "domains": [
        {
          "name": "studio-b.test",
          "verified": false
        }
      ],
      "members": [
        {
          "username": "admin-b",
          "membershipType": "MANAGED"
        }
      ]
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"required\":{\"roles\":[\"user\"]},\"annotations\":{\"inputHelperTextAfter\":\"${photofficeEmailReadOnlyHint}\"},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  }
}
